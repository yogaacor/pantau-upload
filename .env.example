# ---------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# Google Drive — akun tujuan upload (akun kamu sendiri)
# Isi lewat: npm run drive:token
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Folder tujuan di Drive. Diisi otomatis oleh: npm run drive:folder
# Foldernya harus dibuat oleh aplikasi sendiri, karena scope drive.file
# tidak memberi akses ke folder yang sudah ada sebelumnya.
DRIVE_FOLDER_ID=

# Batas ukuran per file, dalam byte. Default 5 GB.
MAX_UPLOAD_BYTES=5368709120
